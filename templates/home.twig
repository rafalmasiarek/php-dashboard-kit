{% extends "layout.twig" %}

{% block title %}Home{% endblock %}

{% block content %}
{% if auth.isLoggedIn() %}
    {% set user = auth.getUser() %}
    <div class="mb-4">
        <h2 class="mb-1">Welcome back, {{ user.get('email') }}</h2>
    </div>

    {% if modules %}
    <div class="row g-3">
        {% for module in modules %}
        <div class="col-sm-6 col-md-4 col-lg-3">
            <a href="{{ dash }}{{ module.path }}" class="card text-decoration-none h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    {% if module.icon %}
                    <span class="fs-3 lh-1">{{ module.icon }}</span>
                    {% endif %}
                    <span class="fw-semibold">{{ module.title }}</span>
                </div>
            </a>
        </div>
        {% endfor %}
    </div>
    {% endif %}

{% else %}
    <div class="py-5 text-center">
        <h1 class="mb-3">{{ app_name }}</h1>
        <div class="d-flex justify-content-center gap-2">
            <a href="{{ dash }}/login" class="btn btn-primary">Log in</a>
            {% if registration_enabled %}
            <a href="{{ dash }}/register" class="btn btn-outline-secondary">Register</a>
            {% endif %}
        </div>
    </div>
{% endif %}
{% endblock %}
