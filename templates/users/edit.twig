{% extends "admin-layout.twig" %}

{% block admin_content %}

{% if editUser.suspended_at %}
<div class="alert alert-warning d-flex justify-content-between align-items-center mb-4">
    <span>Account suspended since {{ editUser.suspended_at }}</span>
    <form method="POST" action="{{ admin_panel }}/users/{{ editUser.id }}/unsuspend" class="mb-0">
        {{ csrf_field('users-unsuspend-' ~ editUser.id) }}
        <button type="submit" class="btn btn-sm btn-success">Unsuspend</button>
    </form>
</div>
{% endif %}

<div class="row">
<div class="col-lg-6">

<form method="POST" action="{{ admin_panel }}/users/{{ editUser.id }}/edit">
    {{ csrf_field('admin-users-edit-' ~ editUser.id) }}

    <div class="mb-3">
        <label class="form-label fw-semibold">Email</label>
        <input type="email" name="email" class="form-control" value="{{ editUser.email }}" required>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">Role</label>
        <select name="role" class="form-select">
            <option value="user"  {% if editUser.role == 'user'  %}selected{% endif %}>User</option>
            <option value="admin" {% if editUser.role == 'admin' %}selected{% endif %}>Admin</option>
        </select>
    </div>

    <div class="mb-4">
        <div class="form-check">
            <input type="checkbox" name="active" id="active" class="form-check-input" value="1"
                   {% if editUser.active %}checked{% endif %}>
            <label class="form-check-label fw-semibold" for="active">Account active</label>
        </div>
    </div>

    {% if user_fields %}
    <hr class="my-4">
    {% for name, field in user_fields %}
    <div class="mb-3">
        <label class="form-label fw-semibold">
            {{ field.label }}
            {% if field.required %}<span class="text-danger ms-1">*</span>{% endif %}
        </label>
        {% if field.type == 'textarea' %}
        <textarea name="{{ name }}" class="form-control" maxlength="{{ field.max }}" rows="3"
                  {% if field.required %}required{% endif %}>{{ editUser[name] ?? '' }}</textarea>
        {% elseif field.type == 'date' %}
        <input type="date" name="{{ name }}" class="form-control"
               value="{{ editUser[name] ?? '' }}"
               {% if field.required %}required{% endif %}>
        {% else %}
        <input type="text" name="{{ name }}" class="form-control" maxlength="{{ field.max }}"
               value="{{ editUser[name] ?? '' }}"
               {% if field.required %}required{% endif %}>
        {% endif %}
    </div>
    {% endfor %}
    {% endif %}

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a href="{{ admin_panel }}/users" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

</div>
</div>
{% endblock %}
