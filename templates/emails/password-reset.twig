{% extends "emails/layout.twig" %}

{% block subject %}Reset your password{% endblock %}

{% block content %}
<h2>Password reset</h2>
<p>We received a request to reset the password for <strong>{{ user_email }}</strong>.</p>
<p>Click the button below to choose a new password:</p>

<a href="{{ reset_link }}" class="btn">Reset Password</a>

<p class="link">Or copy this link into your browser:<br>
<a href="{{ reset_link }}">{{ reset_link }}</a></p>

<p>This link expires in <strong>{{ expires_in ?? '1 hour' }}</strong>.</p>
<p>If you did not request a password reset, you can safely ignore this email.</p>
{% endblock %}
