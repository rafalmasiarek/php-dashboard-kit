{% extends "layout.twig" %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
        <h2 class="mb-4">Login</h2>

        <form method="post" action="{{ dash }}/login">
            {{ csrf_field('login') }}
            {% if from is defined and from %}<input type="hidden" name="from" value="{{ from }}">{% endif %}
            <div class="mb-3">
                <label class="form-label" for="email">Email</label>
                <input type="email" id="email" name="email" class="form-control" required autofocus>
            </div>
            <div class="mb-3">
                <label class="form-label" for="password">Password</label>
                <input type="password" id="password" name="password" class="form-control" required>
            </div>
            {{ form_slot('login', 'form_fields') }}
            <button class="btn btn-primary w-100">Login</button>
        </form>

        {% if password_reset_enabled %}
        <p class="mt-2 text-center">
            <a href="{{ dash }}/forgot-password" class="text-muted small">Forgot password?</a>
        </p>
        {% endif %}
        {% if registration_enabled %}
        <p class="mt-1 text-center text-muted">
            No account? <a href="{{ dash }}/register">Register</a>
        </p>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block scripts %}
{{ form_slot('login', 'scripts') }}
{% endblock %}
