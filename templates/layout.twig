<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title is defined ? title ~ ' — ' : '' }}{{ app_name }}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>.content-body img { max-width: 100%; height: auto; }</style>
    {% block head %}{% endblock %}
</head>
<body>

{% block navbar %}
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="{{ current_path starts with admin_panel ? admin_panel : (dash ~ '/') }}">{{ app_name }}</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarMain">
            <ul class="navbar-nav me-auto">
                {% for slug, module in modules %}
                {% if module.auth_required is same as(false) %}
                    {% set _show = true %}
                {% elseif not auth.isLoggedIn() %}
                    {% set _show = false %}
                {% elseif module.auth_required is same as(true) %}
                    {% set _show = true %}
                {% elseif module.auth_required is iterable %}
                    {% set _show = auth.getUser().get('role') in module.auth_required %}
                {% else %}
                    {% set _show = auth.getUser().get('role') == module.auth_required %}
                {% endif %}
                {% if _show %}
                <li class="nav-item">
                    <a class="nav-link{% if current_path starts with (dash ~ module.path) and module.path != '/' %} active{% elseif current_path == (dash ~ module.path) %} active{% endif %}" href="{{ dash }}{{ module.path }}">
                        {% if module.icon is defined %}{{ module.icon }} {% endif %}{{ module.title }}
                    </a>
                </li>
                {% endif %}
                {% endfor %}
            </ul>
            <ul class="navbar-nav ms-auto">
                {% if auth.isLoggedIn() %}
                {% set _user = auth.getUser() %}
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown">
                        <img src="{{ gravatar_url(_user.getEmail(), 28) }}" width="28" height="28" class="rounded-circle" alt="">
                        {{ _user.getEmail() }}
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="{{ dash }}/settings">Settings</a></li>
                        {% if _user.get('role') == 'admin' %}
                        <li><a class="dropdown-item{% if current_path starts with admin_panel %} active{% endif %}" href="{{ admin_panel }}">Admin</a></li>
                        {% endif %}
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="{{ dash }}/logout">Logout</a></li>
                    </ul>
                </li>
                {% else %}
                <li class="nav-item">
                    <a class="nav-link" href="{{ dash }}/login">Login</a>
                </li>
                {% if registration_enabled %}
                <li class="nav-item">
                    <a class="nav-link" href="{{ dash }}/register">Register</a>
                </li>
                {% endif %}
                {% endif %}
            </ul>
        </div>
    </div>
</nav>
{% endblock %}

{% block header %}{% endblock %}

<div class="container">
    {% for type, messages in flash.get() %}
        {% for message in messages %}
        <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        {% endfor %}
    {% endfor %}

    {% block content %}{% endblock %}
</div>

{% block footer %}{% endblock %}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5/dist/js/bootstrap.bundle.min.js"></script>
{% block scripts %}{% endblock %}
</body>
</html>
