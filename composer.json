{
  "name": "rafalmasiarek/dashboard-kit",
  "description": "Slim 4 dashboard boilerplate with module auto-discovery, dynamic navbar, auth, CSRF protection and built-in API routing.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "psr/container": "^1.1 || ^2.0",
    "psr/log": "^3.0",
    "slim/slim": "^4.12",
    "slim/psr7": "^1.5",
    "slim/twig-view": "^3.3",
    "php-di/php-di": "^6.4",
    "rafalmasiarek/authkit": "^2.1",
    "rafalmasiarek/csrf-token": "^1.0",
    "rafalmasiarek/real-ip-resolver": "^2.1",
    "filp/whoops": "^2.15",
    "monolog/monolog": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "rafalmasiarek\\DashboardKit\\": "src/"
    }
  },
  "minimum-stability": "stable"
}
